+			errText = []byte("(...couldn't fetch stderr: " + err.Error() + ")")
+		}
+		errChan <- errText
+	}()
 	pipeR, pipeW := io.Pipe()
 	go func() {
-		if _, err := io.Copy(pipeW, stdout); err != nil {
+		_, err := io.Copy(pipeW, stdout)
+		if err != nil {
 			pipeW.CloseWithError(err)
 		}
-		if errText, e := ioutil.ReadAll(stderr); e != nil {
-			log.Printf("error while reading from stderr: %v", e)
-			errText = []byte("(...couldn't fetch stderr: " + e.Error() + ")")
